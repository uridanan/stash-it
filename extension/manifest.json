{
  "manifest_version": 3,
  "name": "Stash — Save for later",
  "version": "1.0.0",
  "description": "Save the current page to your Stash reading list.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Stash",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "storage", "contextMenus", "tabs"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
