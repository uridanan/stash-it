# Copy to .env and fill in values. Placeholders only — never put real
# secrets in this file; it is committed.

# Postgres connection. Default matches the docker-compose db published on
# host port 5435 (inside compose the web service uses db:5432 instead).
DATABASE_URL="postgresql://stash:stash@localhost:5435/stash"

# Session encryption secret. Generate with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Google OAuth client (see README "Google OAuth setup"). Optional locally
# when AUTH_DEV_LOGIN=true.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public URL of the app in production (e.g. https://stash.example.com).
# Leave unset for local dev.
# AUTH_URL=""

# Dev-only credentials login for local development and E2E tests.
# NEVER set this in production.
AUTH_DEV_LOGIN="true"

AUTH_TRUST_HOST="true"

# Outbound mail, used by Send to Kindle. Without SMTP_FROM (and SMTP_HOST) the
# feature is hidden rather than broken. SMTP_FROM is the address Amazon must
# have on its Approved Personal Document E-mail List — the settings page shows
# it for exactly that reason.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASSWORD="an-app-password-not-your-real-one"
# SMTP_FROM="you@gmail.com"
