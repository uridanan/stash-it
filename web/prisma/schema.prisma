generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleState {
  UNREAD
  ARCHIVED
}

/** The three independent axes of filling in an imported library. */
enum JobType {
  FETCH_CONTENT
  CLASSIFY
  SUMMARIZE
}

enum JobStatus {
  RUNNING
  DONE
  CANCELLED
  FAILED
}

/** Whether a tag was applied by the user or derived automatically. */
enum TagSource {
  MANUAL
  AUTO
}

/** What kind of signal produced a tag. Drives grouping and styling in the UI. */
enum TagKind {
  TOPIC
  LENGTH
  LANGUAGE
  FORMAT
  SHOPPING
  TTS
  CUSTOM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now())

  /** Whether this person wants summaries written for them. On unless they turn it off. */
  aiSummariesEnabled Boolean @default(true)
  /**
   * Legacy per-account copies. The live model, key, and prompt are on
   * SystemSettings, edited from Admin. These stay so an older backup still reads.
   */
  aiModel     String  @default("gemini-3.1-pro-preview")
  aiApiKey    String?
  aiPrompt    String? @db.Text
  summaryView String  @default("card") // "card" | "tabs"

  /** Topics this person added on top of the system defaults. */
  customTopics String[] @default([])
  /** System defaults this person turned off. */
  excludedTopics String[] @default([])
  /**
   * Collections behavior for this person's imports: "assign" or "import".
   * Null follows SystemSettings.importTags.
   */
  importTagsOverride String?

  /** Mark an article read once narration reaches the end of it. */
  markReadOnListen Boolean @default(false)

  /**
   * Where "Send to Kindle" delivers to (@kindle.com).
   * The account the server sends from lives on SystemSettings.
   */
  kindleEmail String?

  articles Article[]
  tokens   ApiToken[]
  tags     Tag[]
  jobs     BackgroundJob[]
}

/**
 * One row, id "system". Admin edits it; every account reads it.
 *
 * The model, key, prompt, default tags, and import behavior are properties of
 * the installation, not of one person.
 */
model SystemSettings {
  id String @id

  aiModel  String  @default("gemini-3.1-pro-preview")
  aiApiKey String?
  aiPrompt String? @db.Text

  /** Default topic vocabulary offered to Auto-tag. */
  defaultTopics String[] @default([])

  /** "assign" | "import" */
  importTags    String @default("assign")
  /** "missing" | "refresh" */
  importContent String @default("missing")
  /** "ondemand" | "missing" | "always" */
  importSummary String @default("ondemand")

  /**
   * The account that mails articles to Kindle. Null fields fall back to
   * SMTP_* in the environment, which is how tests and an unconfigured
   * install keep working. The password is write-only, like the AI key.
   */
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?
  smtpFrom     String?
}

model Article {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  url              String
  title            String
  siteName         String?
  author           String?
  excerpt          String?
  content          String       @db.Text
  wordCount        Int          @default(0)
  readingMinutes   Int          @default(0)
  leadImageUrl     String?
  state            ArticleState @default(UNREAD)
  starred          Boolean      @default(false)
  extractionFailed Boolean      @default(false)
  summary          String?      @db.Text
  savedAt          DateTime     @default(now())
  readAt           DateTime?

  /** When the source says it was published. Null for most pages — sorts last. */
  publishedAt DateTime?
  /** BCP-47 language from the page, e.g. "he", "fr-CA". */
  lang        String?
  /** Set once AI topic classification has run, so it never runs twice. */
  classifiedAt DateTime?

  /**
   * Signals read off the live page during extraction, which drive the Shopping
   * and Visual content tags.
   *
   * Stored rather than recomputed because they cannot be recovered from the
   * saved article: the sanitizer strips embeds, and the JSON-LD and og: tags
   * they come from are never part of the body. Without them a restore that
   * re-derives its collections would quietly lose both tags.
   */
  isProduct        Boolean @default(false)
  hasEmbeddedMedia Boolean @default(false)

  tags ArticleTag[]

  @@unique([userId, url])
  @@index([userId, state, savedAt(sort: Desc)])
  @@index([userId, state, publishedAt(sort: Desc)])
}

/** A collection. Doubles as a playlist: its articles carry an explicit order. */
model Tag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  kind      TagKind  @default(CUSTOM)
  createdAt DateTime @default(now())

  articles ArticleTag[]

  @@unique([userId, slug])
  @@index([userId, kind])
}

model ArticleTag {
  articleId String
  tagId     String
  /**
   * Order within this tag's playlist. Float so a drag writes the midpoint of
   * its new neighbours (2.0, 3.0 -> 2.5) and only one row is updated.
   */
  position  Float
  source    TagSource @default(MANUAL)
  createdAt DateTime  @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId, position])
}

model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/**
 * A long-running fill-in job.
 *
 * What still needs doing is derived from the articles themselves — empty
 * content, null classifiedAt, null summary — so a job continues after a
 * restart instead of depending on a per-item queue. The row holds the
 * lifecycle, the counters, and the failures from this run so the report is
 * still there when the settings page is opened again.
 */
model BackgroundJob {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   JobType
  status JobStatus @default(RUNNING)

  total  Int @default(0)
  done   Int @default(0)
  failed Int @default(0)

  /**
   * Articles this run could not finish. Shape:
   * `{ articleId, title, url, reason }[]`.
   */
  failures Json @default("[]")

  /**
   * Re-do work that is already done — a forced refetch rather than filling
   * gaps. "What is left" cannot be derived for these, because a refetched
   * article still has content, so they walk the library by cursor instead.
   */
  force  Boolean @default(false)
  cursor String?

  /**
   * Refreshed as each article is handled. A heartbeat older than a few
   * minutes means the runner died, and another process may take the job.
   */
  heartbeatAt DateTime @default(now())
  /** The process currently working this job. Null when nobody holds it. */
  lockId      String?

  /** Set by the user; the runner checks it between items and stops. */
  cancelRequested Boolean @default(false)
  /** Last error, when status is FAILED. */
  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([userId, status])
}
