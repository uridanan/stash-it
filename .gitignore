# Personal exports used for import testing. Real reading history —
# keep it out of a shared repository.
data/

# Mail credentials for Send to Kindle. This is a shared repository — the
# password for a real mailbox has no business in it. email.env is the file
# handed over by hand; smtp.env is the SMTP_*-named copy docker-compose reads.
email.env
smtp.env
*.local.env

# Per-machine compose tweaks (port remaps and the like). Local only.
docker-compose.override.yml

# macOS system files
.DS_Store

